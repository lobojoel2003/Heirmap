{
  "name": "@heirmap/web",
  "version": "1.0.0",
  "private": true,
  "description": "Heirmap web app: guided family-tree builder and heirs' property share calculator. Runs entirely in the browser.",
  "license": "AGPL-3.0-only",
  "author": "Joel Stain Lobo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@heirmap/intestacy": "workspace:*",
    "@xyflow/react": "^12.12.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.1.1"
  }
}
