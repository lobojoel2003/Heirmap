{
  "name": "@heirmap/intestacy",
  "version": "1.0.0",
  "description": "Open, citation-backed US intestacy rules engine for computing heirs' property shares, with one module per state and dated rule versions.",
  "license": "Apache-2.0",
  "author": "Joel Stain Lobo",
  "homepage": "https://github.com/lobojoel2003/Heirmap/tree/main/packages/intestacy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobojoel2003/Heirmap.git",
    "directory": "packages/intestacy"
  },
  "bugs": {
    "url": "https://github.com/lobojoel2003/Heirmap/issues"
  },
  "keywords": [
    "intestacy",
    "inheritance",
    "heirs property",
    "probate",
    "legal aid",
    "title",
    "family tree",
    "rules engine"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
